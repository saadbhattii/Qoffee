# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.iws
*.swp
*.swo
*~
.\#*
\#*\#
.project
.pydevproject
.settings/
*.sublime-workspace
*.sublime-project

# ---------------------------------------------------------------------------
